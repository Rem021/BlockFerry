<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BlockFerry.App.WinUI.Controls.MigrationReviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="ReviewGroupsItemsControl">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="ReviewGroupCard"
                        Margin="0,0,0,8"
                        Padding="12"
                        AutomationProperties.Name="{Binding AutomationName}"
                        Background="{ThemeResource SubtleSurfaceBrush}"
                        BorderBrush="{ThemeResource SubtleStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Background="{ThemeResource OptionCardIconSurfaceBrush}"
                                    CornerRadius="9"
                                    IsHitTestVisible="False">
                                <FontIcon HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"
                                          FontSize="15"
                                          Foreground="{ThemeResource OptionCardIconForegroundBrush}"
                                          Glyph="{Binding Glyph}"
                                          IsHitTestVisible="False" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource DrawerTextBrush}"
                                       Text="{Binding Title}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource DrawerSecondaryTextBrush}"
                                       Text="{Binding CountText}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ReviewItemCard"
                                            Margin="0,0,0,6"
                                            Padding="10"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Background="{ThemeResource DrawerSurfaceBrush}"
                                            CornerRadius="10">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource DrawerTextBrush}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource DrawerSecondaryTextBrush}"
                                                       MaxLines="3"
                                                       Text="{Binding Summary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
