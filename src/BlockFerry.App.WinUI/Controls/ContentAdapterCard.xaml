<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BlockFerry.App.WinUI.Controls.ContentAdapterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlockFerry.App.WinUI.Controls">
    <Border
        x:Name="AdapterSurface"
        Padding="0"
        Background="{ThemeResource OptionCategorySurfaceBrush}"
        BorderBrush="{ThemeResource OptionCardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="16">
        <Grid>
            <Border
                x:Name="AdapterSelectedSurface"
                AutomationProperties.AccessibilityView="Raw"
                BorderBrush="{ThemeResource OptionCardSelectedStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                IsHitTestVisible="False"
                Opacity="0" />
            <StackPanel Padding="12" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="AdapterCheckBox"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="AdapterCheckBox_Click"
                        UseSystemFocusVisuals="True">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="34"
                                Height="34"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{ThemeResource OptionCardIconSurfaceBrush}"
                                CornerRadius="10"
                                IsHitTestVisible="False">
                                <SymbolIcon
                                    x:Name="AdapterIcon"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Foreground="{ThemeResource OptionCardIconForegroundBrush}"
                                    IsHitTestVisible="False"
                                    Symbol="Setting" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    x:Name="AdapterTitleText"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource DrawerTextBrush}"
                                    Text="同步内容" />
                                <TextBlock
                                    x:Name="AdapterDescriptionText"
                                    FontSize="12"
                                    Foreground="{ThemeResource DrawerSecondaryTextBrush}"
                                    Text="正在读取内容"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="AdapterSummaryText"
                                    FontSize="12"
                                    Foreground="{ThemeResource DrawerTextBrush}"
                                    Text="等待读取实例内容" />
                            </StackPanel>
                        </Grid>
                    </CheckBox>
                    <local:ExpandCollapseButton
                        x:Name="AdapterDisclosureButton"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="展开同步内容详情"
                        IsExpanded="False"
                        Style="{StaticResource QuietButtonStyle}"
                        UseSystemFocusVisuals="True" />
                </Grid>

                <TextBlock
                    x:Name="AdapterDisabledReasonText"
                    FontSize="12"
                    Foreground="{ThemeResource DrawerSecondaryTextBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Border
                    x:Name="AdapterDetailsRegion"
                    MaxHeight="0"
                    Opacity="0"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <Border
                            x:Name="EmiUnsupportedStatus"
                            Padding="10"
                            AutomationProperties.Name="检测到 EMI 收藏：beta.4 暂不支持"
                            Background="{ThemeResource OptionLockedSafetyStripBrush}"
                            CornerRadius="10"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    Foreground="{ThemeResource WarningBrush}"
                                    IsHitTestVisible="False"
                                    Symbol="Important" />
                                <TextBlock
                                    x:Name="EmiUnsupportedText"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource DrawerTextBrush}"
                                    Text="检测到 EMI 收藏：beta.4 暂不支持"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="AdapterItemsPanel" Spacing="6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
