<?xml version="1.0" encoding="utf-8"?>
<!-- A native tall title bar keeps custom actions on the same baseline as Windows caption buttons. -->
<Window
    x:Class="BlockFerry.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BlockFerry.App.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BlockFerry · 方块渡口"
    mc:Ignorable="d">

    <Grid x:Name="WindowRoot"
          Background="{ThemeResource SceneBaseBrush}"
          PointerEntered="WindowRoot_PointerEntered"
          PointerExited="WindowRoot_PointerExited"
          PointerMoved="WindowRoot_PointerMoved">
        <Image x:Name="SceneBackgroundImage"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               AutomationProperties.AccessibilityView="Raw"
               IsHitTestVisible="False"
               Stretch="UniformToFill" />

        <!-- Both layers stay beneath the veil: a restrained core keeps the light
             connected to the pointer while a faint slower layer supplies inertia. -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="TrailPointerGlow"
                     Width="320"
                     Height="264"
                     Fill="{ThemeResource PointerGlowWeakBrush}"
                     Opacity="0" />
            <Ellipse x:Name="BackgroundPointerGlow"
                     Width="220"
                     Height="180"
                     Fill="{ThemeResource PointerGlowStrongBrush}"
                     Opacity="0" />
        </Canvas>

        <Rectangle x:Name="SceneVeil"
                   Fill="{ThemeResource SceneVeilBrush}"
                   AutomationProperties.AccessibilityView="Raw"
                   IsHitTestVisible="False" />

        <!-- The fully rendered outgoing scene stays above the new theme until the
             incoming bitmap has decoded, preventing a light/dark blank frame. -->
        <Grid x:Name="ThemeTransitionCover"
              AutomationProperties.AccessibilityView="Raw"
              IsHitTestVisible="False"
              Opacity="0">
            <Image x:Name="PreviousSceneBackgroundImage"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   Stretch="UniformToFill" />
            <Rectangle x:Name="PreviousSceneVeil"
                       IsHitTestVisible="False" />
        </Grid>

        <Grid x:Name="ContentLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TopBar" Grid.Row="0" Canvas.ZIndex="20">
                <Rectangle x:Name="TopBlurLayer"
                           Fill="{ThemeResource TopAcrylicBrush}"
                           IsHitTestVisible="False"
                           Opacity="0.56" />
                <Rectangle Margin="0,0,0,-38"
                           Fill="{ThemeResource TopFadeBrush}"
                           IsHitTestVisible="False" />

                <Grid Padding="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="CaptionRightPaddingColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="DragRegion"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Background="Transparent" />

                    <StackPanel Grid.Column="0"
                                Height="32"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Border Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleSurfaceBrush}"
                                BorderBrush="{ThemeResource SubtleStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid Width="18" Height="18">
                                <Border Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        BorderBrush="{ThemeResource SceneTextBrush}" BorderThickness="2" CornerRadius="1" />
                                <Border Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        BorderBrush="{ThemeResource SceneTextBrush}" BorderThickness="2" CornerRadius="1" />
                                <Border Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        BorderBrush="{ThemeResource SceneTextBrush}" BorderThickness="2" CornerRadius="1" />
                            </Grid>
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="15"
                                   Foreground="{ThemeResource SceneTextBrush}"
                                   Text="BlockFerry" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Height="48"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="0">
                        <Button x:Name="UpdateButton"
                                Height="36"
                                MinHeight="36"
                                VerticalAlignment="Center"
                                Padding="11,0"
                                AutomationProperties.Name="查看 BlockFerry 新版本"
                                Background="{ThemeResource OptionCategorySelectedSurfaceBrush}"
                                BorderBrush="{ThemeResource OptionCardSelectedStrokeBrush}"
                                BorderThickness="1"
                                Click="UpdateButton_Click"
                                CornerRadius="9"
                                Foreground="{ThemeResource SceneTextBrush}"
                                ToolTipService.ToolTip="在 GitHub 查看新版本"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <TextBlock x:Name="UpdateVersionText"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="发现新版本" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ThemeButton"
                                AutomationProperties.Name="切换颜色主题"
                                Click="ThemeButton_Click"
                                Style="{StaticResource TitleBarChromeButtonStyle}"
                                ToolTipService.ToolTip="切换颜色主题">
                            <FontIcon x:Name="ThemeGlyph" FontSize="16" Glyph="&#xE706;" />
                        </Button>
                        <Button x:Name="LanguageButton"
                                AutomationProperties.Name="Switch interface language"
                                Click="LanguageButton_Click"
                                Style="{StaticResource TitleBarChromeButtonStyle}"
                                ToolTipService.ToolTip="Switch to English">
                            <Grid Width="46"
                                  Height="48"
                                  AutomationProperties.AccessibilityView="Raw"
                                  IsHitTestVisible="False">
                                <TextBlock x:Name="LanguageButtonText"
                                           Width="28"
                                           Height="18"
                                           Margin="0,-2,0,2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           LineHeight="16"
                                           Text="EN"
                                           TextAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Frame x:Name="RootFrame"
                   Grid.Row="1"
                   Background="Transparent" />
        </Grid>

    </Grid>
</Window>
