<!-- Generated from Microsoft's WinUI CLI template, then adapted for unpackaged framework-dependent deployment. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BlockFerry.App.WinUI</RootNamespace>
    <AssemblyName>BlockFerry.App.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>beta.4</VersionSuffix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.4</FileVersion>
    <BlockFerryCoreProject Condition="'$(BlockFerryCoreProject)' == ''">..\BlockFerry.Core\BlockFerry.Core.csproj</BlockFerryCoreProject>
    <ThirdPartyNoticesPath Condition="'$(ThirdPartyNoticesPath)' == '' and Exists('..\..\THIRD-PARTY-NOTICES.txt')">..\..\THIRD-PARTY-NOTICES.txt</ThirdPartyNoticesPath>
    <ThirdPartyNoticesPath Condition="'$(ThirdPartyNoticesPath)' == ''">THIRD-PARTY-NOTICES.txt</ThirdPartyNoticesPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin-*\**;bin-*/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\blockferry-ambient.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\blockferry-ambient-light.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\NotoSansSC-Variable.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\NotoSansSC-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ThirdPartyNoticesPath)" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(BlockFerryCoreProject)')">
    <ProjectReference Include="$(BlockFerryCoreProject)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
