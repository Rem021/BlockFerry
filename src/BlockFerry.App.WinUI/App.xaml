<?xml version="1.0" encoding="utf-8"?>
<!-- Shared light, dark, and high-contrast resources for the native scene. -->
<Application
    x:Class="BlockFerry.App.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlockFerry.App.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SceneBaseBrush" Color="#111315" />
                    <SolidColorBrush x:Key="SceneTextBrush" Color="#F8F9FA" />
                    <SolidColorBrush x:Key="SceneSecondaryTextBrush" Color="#B7BBC2" />
                    <SolidColorBrush x:Key="SceneTertiaryTextBrush" Color="#858B94" />
                    <SolidColorBrush x:Key="DisplayNumberBrush" Color="#4BFFFFFF" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="SubtleStrokeBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="DrawerSurfaceBrush" Color="#F2191B1F" />
                    <SolidColorBrush x:Key="DrawerTextBrush" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="DrawerSecondaryTextBrush" Color="#AEB3BC" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#58D78C" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F2B84B" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#32FFFFFF" />
                    <SolidColorBrush x:Key="OptionCategorySurfaceBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="OptionCategorySelectedSurfaceBrush" Color="#2A0A84FF" />
                    <SolidColorBrush x:Key="OptionCardStrokeBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="OptionCardSelectedStrokeBrush" Color="#660A84FF" />
                    <SolidColorBrush x:Key="OptionCardIconSurfaceBrush" Color="#1F0A84FF" />
                    <SolidColorBrush x:Key="OptionCardIconForegroundBrush" Color="#67B0FF" />
                    <SolidColorBrush x:Key="OptionSettingHoverBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="OptionSettingPressedBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="OptionLockedSafetyStripBrush" Color="#22F2B84B" />
                    <SolidColorBrush x:Key="OptionSelectionFooterBrush" Color="#1CFFFFFF" />
                    <SolidColorBrush x:Key="OptionResultSuccessSurfaceBrush" Color="#2258D78C" />
                    <SolidColorBrush x:Key="TopSolidBrush" Color="#E8101113" />
                    <SolidColorBrush x:Key="BottomSolidBrush" Color="#E80C0E10" />
                    <AcrylicBrush x:Key="TopAcrylicBrush"
                                  FallbackColor="#E8101113"
                                  TintColor="#111315"
                                  TintLuminosityOpacity="0.50"
                                  TintOpacity="0.20" />
                    <AcrylicBrush x:Key="DrawerAcrylicBrush"
                                  FallbackColor="#F2191B1F"
                                  TintColor="#1B1D21"
                                  TintLuminosityOpacity="0.58"
                                  TintOpacity="0.72" />
                    <LinearGradientBrush x:Key="SceneVeilBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#5A050607" />
                        <GradientStop Offset="0.45" Color="#12050607" />
                        <GradientStop Offset="1" Color="#24000000" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="TopFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#720B0C0E" />
                        <GradientStop Offset="0.55" Color="#360B0C0E" />
                        <GradientStop Offset="1" Color="#000B0C0E" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BottomFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#00090A0C" />
                        <GradientStop Offset="0.46" Color="#50090A0C" />
                        <GradientStop Offset="1" Color="#D5090A0C" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="PointerGlowStrongBrush"
                                         Center="0.5,0.5"
                                         GradientOrigin="0.5,0.5"
                                         RadiusX="0.5"
                                         RadiusY="0.5">
                        <GradientStop Offset="0" Color="#30DED6CC" />
                        <GradientStop Offset="0.3" Color="#2ADAD2C8" />
                        <GradientStop Offset="0.6" Color="#17C8C0B7" />
                        <GradientStop Offset="0.84" Color="#06B6AFA8" />
                        <GradientStop Offset="1" Color="#00B6AFA8" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="PointerGlowWeakBrush"
                                         Center="0.5,0.5"
                                         GradientOrigin="0.5,0.5"
                                         RadiusX="0.5"
                                         RadiusY="0.5">
                        <GradientStop Offset="0" Color="#22F5EEE5" />
                        <GradientStop Offset="0.36" Color="#1DEFE7DD" />
                        <GradientStop Offset="0.7" Color="#08D8D0C7" />
                        <GradientStop Offset="1" Color="#00D8D0C7" />
                    </RadialGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SceneBaseBrush" Color="#F4F0EA" />
                    <SolidColorBrush x:Key="SceneTextBrush" Color="#17181A" />
                    <SolidColorBrush x:Key="SceneSecondaryTextBrush" Color="#53565C" />
                    <SolidColorBrush x:Key="SceneTertiaryTextBrush" Color="#777A80" />
                    <SolidColorBrush x:Key="DisplayNumberBrush" Color="#3117191C" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="SubtleStrokeBrush" Color="#2E30343A" />
                    <SolidColorBrush x:Key="DrawerSurfaceBrush" Color="#F7F8F5F1" />
                    <SolidColorBrush x:Key="DrawerTextBrush" Color="#17181A" />
                    <SolidColorBrush x:Key="DrawerSecondaryTextBrush" Color="#5C6067" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#177948" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#9A5D00" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#3217191C" />
                    <SolidColorBrush x:Key="OptionCategorySurfaceBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="OptionCategorySelectedSurfaceBrush" Color="#220A64C8" />
                    <SolidColorBrush x:Key="OptionCardStrokeBrush" Color="#2E30343A" />
                    <SolidColorBrush x:Key="OptionCardSelectedStrokeBrush" Color="#660A64C8" />
                    <SolidColorBrush x:Key="OptionCardIconSurfaceBrush" Color="#180A64C8" />
                    <SolidColorBrush x:Key="OptionCardIconForegroundBrush" Color="#0A64C8" />
                    <SolidColorBrush x:Key="OptionSettingHoverBrush" Color="#1830343A" />
                    <SolidColorBrush x:Key="OptionSettingPressedBrush" Color="#2630343A" />
                    <SolidColorBrush x:Key="OptionLockedSafetyStripBrush" Color="#24C67B00" />
                    <SolidColorBrush x:Key="OptionSelectionFooterBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="OptionResultSuccessSurfaceBrush" Color="#18177948" />
                    <SolidColorBrush x:Key="TopSolidBrush" Color="#F3F7F4EF" />
                    <SolidColorBrush x:Key="BottomSolidBrush" Color="#F4F8F5F0" />
                    <AcrylicBrush x:Key="TopAcrylicBrush"
                                  FallbackColor="#F3F7F4EF"
                                  TintColor="#FAF8F4"
                                  TintLuminosityOpacity="0.64"
                                  TintOpacity="0.28" />
                    <AcrylicBrush x:Key="DrawerAcrylicBrush"
                                  FallbackColor="#F7F8F5F1"
                                  TintColor="#FAF8F4"
                                  TintLuminosityOpacity="0.72"
                                  TintOpacity="0.78" />
                    <LinearGradientBrush x:Key="SceneVeilBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#54FFFFFF" />
                        <GradientStop Offset="0.45" Color="#0CFFFFFF" />
                        <GradientStop Offset="1" Color="#12FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="TopFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#88F9F6F1" />
                        <GradientStop Offset="0.55" Color="#42F9F6F1" />
                        <GradientStop Offset="1" Color="#00F9F6F1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BottomFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#00FAF8F4" />
                        <GradientStop Offset="0.44" Color="#78FAF8F4" />
                        <GradientStop Offset="1" Color="#EBFAF8F4" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="PointerGlowStrongBrush"
                                         Center="0.5,0.5"
                                         GradientOrigin="0.5,0.5"
                                         RadiusX="0.5"
                                         RadiusY="0.5">
                        <GradientStop Offset="0" Color="#60FFFDF8" />
                        <GradientStop Offset="0.3" Color="#54FFF9F0" />
                        <GradientStop Offset="0.6" Color="#2CEEE8DE" />
                        <GradientStop Offset="0.84" Color="#0AD9D4CC" />
                        <GradientStop Offset="1" Color="#00D9D4CC" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="PointerGlowWeakBrush"
                                         Center="0.5,0.5"
                                         GradientOrigin="0.5,0.5"
                                         RadiusX="0.5"
                                         RadiusY="0.5">
                        <GradientStop Offset="0" Color="#38FFFFFF" />
                        <GradientStop Offset="0.38" Color="#30FFF9F0" />
                        <GradientStop Offset="0.72" Color="#0CE9E3DA" />
                        <GradientStop Offset="1" Color="#00E9E3DA" />
                    </RadialGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SceneBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SceneTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SceneSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SceneTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DisplayNumberBrush" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="0.22" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SubtleStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DrawerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DrawerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DrawerSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OptionCategorySurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OptionCategorySelectedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OptionCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OptionCardSelectedStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="OptionCardIconSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OptionCardIconForegroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="OptionSettingHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OptionSettingPressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OptionLockedSafetyStripBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OptionSelectionFooterBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OptionResultSuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TopSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BottomSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TopAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DrawerAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SceneVeilBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TopFadeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BottomFadeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PointerGlowStrongBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="PointerGlowWeakBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>

            <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource SceneSecondaryTextBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="TitleBarChromeButtonStyle"
                   BasedOn="{StaticResource ChromeIconButtonStyle}"
                   TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="46" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource SceneSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="168" />
                <Setter Property="MinHeight" Value="54" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#0A84FF" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
